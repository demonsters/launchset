---
/**
 * The homepage below the hero: how a release goes, what lands in each target's files, who does
 * what, the awkward cases, where launchset fits next to other tools, and how to start. Colours
 * of the four example targets match the trails in the hero.
 */
import { Code, Icon } from "@astrojs/starlight/components";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const to = (path: string) => `${base}/${path}`;

const steps = [
  {
    title: "Add a changeset to your PR",
    body: "A changeset is a short markdown file: how big the change is and one line for the changelog. `launchset add` writes it for you. Commit messages don't matter, and the PR check tells you when one is missing.",
    code: {
      lang: "md",
      title: ".launchset/brave-lions-sing.md",
      text: "---\nbump: minor\n---\n\nAdd offline mode to the mobile app.",
    },
  },
  {
    title: "launchset keeps a release PR open",
    body: "Every pending changeset goes into one pull request: the version bump, the version written into each target's files and the new changelog section. It is rebuilt on every push, so it never has conflicts.",
    code: {
      lang: "text",
      title: "Release v1.5.0",
      text: [
        "launchset/release/main into main",
        "",
        "M  package.json                 1.4.2 → 1.5.0",
        "M  android/app/build.gradle     versionName",
        "M  ios/App.xcodeproj/project.pbxproj",
        "M  CHANGELOG.md",
        "D  .launchset/brave-lions-sing.md",
      ].join("\n"),
    },
  },
  {
    title: "Merge it, and every target builds",
    body: "The release workflow plans one job per target. Each job writes the version and a fresh build number into its checkout, runs your own build and upload steps, and records a marker tag. Nothing is committed.",
    code: {
      lang: "json",
      title: "launchset plan",
      text: '{\n  "mode": "publish",\n  "version": "1.5.0",\n  "buildNumber": 217175105,\n  "channel": "release",\n  "matrix": ["api", "web", "android", "ios"]\n}',
    },
  },
  {
    title: "The version is tagged when everything shipped",
    body: "Once every target has its marker, launchset tags `v1.5.0` and publishes the GitHub Release with the changelog. If a job fails, re-run it: targets that already shipped are skipped.",
    code: {
      lang: "sh",
      title: "Terminal",
      text: "git tag --list 'launchset/*@1.5.0' 'v1.5.0'\nlaunchset/android@1.5.0\nlaunchset/api@1.5.0\nlaunchset/ios@1.5.0\nlaunchset/web@1.5.0\nv1.5.0",
    },
  },
];

const inline = (text: string) => text.replace(/`([^`]+)`/g, "<code>$1</code>");

const targets = [
  {
    type: "docker",
    trail: "sky",
    name: "Docker",
    version:
      "The image tags (<code>1.5.0</code>, <code>1.5</code>, <code>1</code>, <code>latest</code>) and OCI labels, handed to your build-push step.",
    build: "Not used.",
    link: "targets/docker/",
  },
  {
    type: "android",
    trail: "flame",
    name: "Android",
    version:
      "<code>versionName</code> in <code>build.gradle</code>, <code>build.gradle.kts</code> or <code>gradle.properties</code>.",
    build: "<code>versionCode</code>",
    link: "targets/android/",
  },
  {
    type: "ios",
    trail: "violet",
    name: "iOS",
    version:
      "<code>MARKETING_VERSION</code> in the Xcode project or an xcconfig, or <code>CFBundleShortVersionString</code> in <code>Info.plist</code>.",
    build: "<code>CURRENT_PROJECT_VERSION</code> or <code>CFBundleVersion</code>",
    link: "targets/ios/",
  },
  {
    type: "web",
    trail: "hull",
    name: "Web",
    version: "Nothing by default. List extra files if your app shows its version.",
    build: "Not used.",
    link: "targets/web/",
  },
  {
    type: "custom",
    trail: "none",
    name: "Custom",
    version:
      "Any JSON or YAML key, or a regex: an SDK's <code>package.json</code>, a Helm chart, a version file.",
    build: "A <code>{buildNumber}</code> placeholder, if you use one.",
    link: "targets/custom/",
  },
];

const split = [
  ["Write a changeset in each PR.", "Checks the PR has one and comments on it."],
  [
    "Review and merge the release PR.",
    "Opens and updates it, with the changelog and the version files.",
  ],
  [
    "Write the build and upload steps.",
    "Plans the matrix, writes version and build number, checks the store, records markers.",
  ],
  [
    "Fix and re-run a failed target.",
    "Skips what already shipped, and tags the release when every target did.",
  ],
];

const cases = [
  {
    title: "Preview builds",
    link: "guides/previews/",
    body: "Label a PR `launchset:preview` to get a TestFlight, Play internal or Docker build at `1.5.0-pr.123.4`. Nothing is committed or tagged.",
  },
  {
    title: "Build numbers",
    link: "guides/build-numbers/",
    body: "Seconds since 2020 by default: always higher, on every branch, with nothing stored. Checked against the stores if you want.",
  },
  {
    title: "Hotfixes",
    link: "guides/hotfixes/",
    body: "Release `1.4.1` from `release/1.4.x` with the same changeset flow. launchset opens the PR that copies the changelog back to `main`.",
  },
  {
    title: "Unfinished releases",
    link: "guides/partial-releases/",
    body: "If 1.4.0 never finished, 1.5.0 replaces it. 1.4.0 keeps a GitHub Release marked partial and never gets a release tag.",
  },
  {
    title: "Manual targets",
    link: "guides/manual-targets/",
    body: "An app that ships when you decide still gets every version written into its files, and ships with one click.",
  },
  {
    title: "Dependabot and Renovate",
    link: "guides/bot-prs/",
    body: "Bot PRs pass the check without a changeset. The release PR lists them as patch changes, from their titles.",
  },
  {
    title: "Moving an existing repo",
    link: "guides/migrating/",
    body: "`init` reads your current versions and build numbers, and never lowers either. An agent can run it for you with the adoption skill.",
  },
  {
    title: "Mobile stacks",
    link: "targets/",
    body: "React Native, Capacitor and Expo apps use the same Android and iOS targets, pointed at their own files.",
  },
];

const fit = {
  good: [
    "One product, released as several things at once: an API image, a web app, Android and iOS apps.",
    "You want each PR to say what it changes in a changeset, and a release PR to review.",
    "You'd rather not script `versionName`, `MARKETING_VERSION` and store build numbers yourself.",
  ],
  other: [
    "You publish libraries with versions of their own: Changesets or release-please.",
    "Your team writes Conventional Commits and wants every merge to release: semantic-release.",
    "Your CI isn't GitHub Actions or GitLab CI: semantic-release runs on most CI services.",
  ],
};

const hosts = [
  {
    icon: "github",
    name: "GitHub",
    detail: "A public Action and your own GitHub App",
    link: "getting-started/",
  },
  {
    icon: "gitlab",
    name: "GitLab",
    detail: "GitLab.com and self-managed 18.2+",
    link: "gitlab/getting-started/",
  },
] as const;

const ships = [
  { name: "Docker", trail: "sky", link: "targets/docker/" },
  { name: "Web", trail: "hull", link: "targets/web/" },
  { name: "Android", trail: "flame", link: "targets/android/" },
  { name: "iOS", trail: "violet", link: "targets/ios/" },
  { name: "React Native", trail: "flame", link: "targets/react-native/" },
  { name: "Capacitor", trail: "violet", link: "targets/capacitor/" },
  { name: "Expo", trail: "sky", link: "targets/expo/" },
  { name: "Custom", trail: "none", link: "targets/custom/" },
];

const docs = [
  {
    title: "Start here",
    trail: "sky",
    blurb: "Set up a repo and cut a first release.",
    links: [
      ["Getting started", "getting-started/"],
      ["Concepts", "concepts/"],
      ["Writing changesets", "changesets/"],
      ["GitHub App setup", "github-app/"],
    ],
  },
  {
    title: "Targets",
    trail: "flame",
    blurb: "What gets built, and where the version goes.",
    links: [
      ["All target types", "targets/"],
      ["Docker", "targets/docker/"],
      ["Android", "targets/android/"],
      ["iOS", "targets/ios/"],
    ],
  },
  {
    title: "Guides",
    trail: "violet",
    blurb: "The release flow and the cases around it.",
    links: [
      ["Release flow", "guides/release-flow/"],
      ["Previews and prereleases", "guides/previews/"],
      ["Workflow recipes", "guides/recipes/"],
      ["Migrating a repo", "guides/migrating/"],
    ],
  },
  {
    title: "GitLab",
    trail: "flame",
    blurb: "The same flow, run from GitLab CI.",
    links: [
      ["launchset on GitLab", "gitlab/getting-started/"],
      ["Token and permissions", "gitlab/token/"],
      ["Previews on GitLab", "gitlab/previews/"],
      ["GitLab reference", "gitlab/reference/"],
    ],
  },
  {
    title: "Store pipelines",
    trail: "violet",
    blurb: "One-time setup for TestFlight and Google Play.",
    links: [
      ["Overview and secrets", "store-pipelines/"],
      ["Apple", "store-pipelines/apple/"],
      ["Google Play", "store-pipelines/google-play/"],
    ],
  },
  {
    title: "Reference",
    trail: "sky",
    blurb: "Generated from the code, so it can't drift.",
    links: [
      ["Configuration", "reference/configuration/"],
      ["CLI", "reference/cli/"],
      ["GitHub Action", "reference/action/"],
      ["Troubleshooting", "reference/troubleshooting/"],
    ],
  },
];
---

<div class="ls-home not-content">
  <section class="ls-strip" aria-label="Where launchset runs and what it ships">
    <div class="ls-strip__group">
      <h2 class="ls-strip__label">Runs on</h2>
      <ul class="ls-hosts">
        {
          hosts.map((h) => (
            <li>
              <a href={to(h.link)} class="ls-host">
                <Icon name={h.icon} size="1.5rem" />
                <span>
                  <strong>{h.name}</strong>
                  <span class="ls-host__detail">{h.detail}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="ls-strip__group">
      <h2 class="ls-strip__label">Ships</h2>
      <ul class="ls-ships">
        {
          ships.map((s) => (
            <li>
              <a href={to(s.link)} class="ls-target" data-trail={s.trail}>{s.name}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="ls-section" aria-labelledby="flow">
    <h2 id="flow" class="ls-h2">From pull request to release</h2>
    <ol class="ls-steps">
      {
        steps.map((step, i) => (
          <li class="ls-step">
            <span class="ls-step__number" aria-hidden="true">{i + 1}</span>
            <div class="ls-step__text">
              <h3 class="ls-h3">{step.title}</h3>
              <p set:html={inline(step.body)} />
            </div>
            <div class="ls-step__artifact">
              <Code code={step.code.text} lang={step.code.lang} title={step.code.title} />
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="ls-section" aria-labelledby="files">
    <h2 id="files" class="ls-h2">The version, in each target's own files</h2>
    <p class="ls-intro">
      launchset changes only the characters that hold the version. Indentation, comments and line
      endings stay as they are, and a release PR's diff shows the versions and nothing else.
    </p>
    <div class="ls-table-wrap">
      <table class="ls-targets">
        <thead>
          <tr>
            <th scope="col">Target</th>
            <th scope="col">The version goes into</th>
            <th scope="col">The build number goes into</th>
          </tr>
        </thead>
        <tbody>
          {
            targets.map((t) => (
              <tr>
                <th scope="row">
                  <a href={to(t.link)} class="ls-target" data-trail={t.trail}>{t.name}</a>
                </th>
                <td set:html={t.version} />
                <td set:html={t.build} />
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="ls-note">
      Build numbers are written in CI at build time and never committed. React Native, Capacitor
      and Expo apps use the Android and iOS targets: see <a href={to("targets/")}>Targets</a>.
    </p>
  </section>

  <section class="ls-section ls-split" aria-labelledby="split">
    <div>
      <h2 id="split" class="ls-h2">launchset decides. Your workflow builds.</h2>
      <p class="ls-intro">
        launchset doesn't run Gradle, Xcode or Docker. It works out what to release and writes the
        numbers; your own steps (<code>docker/build-push-action</code>, fastlane, Gradle, Xcode)
        build and upload. State lives in git tags, so there is no database to keep.
      </p>
    </div>
    <table class="ls-duties">
      <thead>
        <tr>
          <th scope="col">You</th>
          <th scope="col">launchset</th>
        </tr>
      </thead>
      <tbody>
        {
          split.map(([you, tool]) => (
            <tr>
              <td>{you}</td>
              <td>{tool}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <section class="ls-section" aria-labelledby="cases">
    <h2 id="cases" class="ls-h2">The awkward cases are covered</h2>
    <dl class="ls-cases">
      {
        cases.map((c) => (
          <div class="ls-case">
            <dt>
              <a href={to(c.link)}>{c.title}</a>
            </dt>
            <dd set:html={inline(c.body)} />
          </div>
        ))
      }
    </dl>
  </section>

  <section class="ls-section" aria-labelledby="fit">
    <h2 id="fit" class="ls-h2">Where launchset fits</h2>
    <p class="ls-intro">
      launchset borrows changesets and the release PR from Changesets. It's built for apps and
      images that share one version, not for libraries that each have their own. For those, the
      established tools do a better job.
    </p>
    <div class="ls-fit">
      <div>
        <h3 class="ls-h3">launchset is a good fit when</h3>
        <ul>{fit.good.map((item) => <li set:html={inline(item)} />)}</ul>
      </div>
      <div>
        <h3 class="ls-h3">Pick another tool when</h3>
        <ul>{fit.other.map((item) => <li set:html={inline(item)} />)}</ul>
      </div>
    </div>
    <p class="ls-note">
      Feature by feature against Changesets, release-please and semantic-release, including where
      they're ahead: <a href={to("comparison/")}>Compared to other tools</a>.
    </p>
  </section>

  <section class="ls-section ls-split" aria-labelledby="agents">
    <div>
      <h2 id="agents" class="ls-h2">Hand it to an agent</h2>
      <p class="ls-intro">
        launchset ships two agent skills. The adoption skill lets an agent such as Claude Code move
        an existing repo onto launchset: it reads what <code>init</code> found, asks you only the
        questions that matter and opens one PR. Once a repo uses launchset, <code>init</code>
        installs a second skill: it tells every agent working there to add a changeset, pick the
        right bump and leave version numbers, the changelog and tags alone.
      </p>
      <p class="ls-note">
        The store pipeline pages are written for a person and an agent together. The agent guides
        and checks; it never sees a secret. <a href={to("guides/migrating/#the-adoption-skill")}
          >About the adoption skill</a
        >
      </p>
    </div>
    <div class="ls-step__artifact">
      <Code
        lang="sh"
        title="What the agent runs"
        code={[
          "# 1. Look, and write nothing",
          "npx launchset init --detect --json",
          "",
          "# 2. After asking you what it couldn't decide",
          "npx launchset init --yes \\",
          "  --decide version=1.4.2 --decide target.ios=manual",
        ].join("\n")}
      />
    </div>
  </section>

  <section class="ls-section ls-start" aria-labelledby="start">
    <h2 id="start" class="ls-h2">Set up a repo</h2>
    <p class="ls-intro">
      <code>init</code> finds your current version, Dockerfiles and native projects, then writes the
      config and three workflows. Run it with <code>--detect</code> first to see what it would do
      without writing anything.
    </p>
    <Code code="npx launchset init --detect" lang="sh" />
    <p class="ls-note">
      The CLI is <code>launchset</code> on npm. CI uses the action
      <code>demonsters/launchset-action@v1</code>, which needs no npm access.
    </p>
    <p>
      <a class="ls-start__link" href={to("getting-started/")}>Read Getting started</a>
    </p>
  </section>

  <section class="ls-section" aria-labelledby="docs">
    <h2 id="docs" class="ls-h2">Explore the docs</h2>
    <div class="ls-docs">
      {
        docs.map((d) => (
          <nav class="ls-doc" aria-label={d.title} data-trail={d.trail}>
            <h3 class="ls-h3">
              <a href={to(d.links[0][1])}>{d.title}</a>
            </h3>
            <p>{d.blurb}</p>
            <ul>
              {d.links.map(([label, link]) => (
                <li>
                  <a href={to(link)}>{label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
  </section>

  <footer class="ls-footer">
    <div class="ls-footer__oss" id="open-source">
      <h2 class="ls-footer__title">Open source</h2>
      <p>
        launchset is built and used at
        <a href="https://demonsters.nl" target="_blank" rel="noopener">De Monsters</a>, and open source
        under the MIT license. Issues and pull requests are welcome on
        <a href="https://github.com/demonsters/launchset">GitHub</a>.
      </p>
    </div>
    <div class="ls-footer__links">
      <a href={to("getting-started/")}>Docs</a>
      <a href={to("reference/cli/")}>CLI</a>
      <a href={to("reference/configuration/")}>Configuration</a>
      <a href="https://github.com/demonsters/launchset">Source on GitHub</a>
      <a href="https://github.com/demonsters/launchset-action">GitHub Action</a>
      <a href="https://github.com/demonsters">demonsters on GitHub</a>
    </div>
  </footer>
</div>

<style>
  .ls-home {
    --gap-section: clamp(4rem, 9vw, 7rem);
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--sl-color-gray-2);
  }

  .ls-section {
    margin-top: var(--gap-section);
  }

  .ls-h2 {
    margin: 0 0 1.25rem;
    max-width: 22ch;
    font-size: clamp(1.85rem, 4vw, 2.75rem);
    font-weight: 750;
    font-family: var(--ls-font-display);
    line-height: 1.05;
    letter-spacing: -0.015em;
    color: var(--sl-color-white);
  }
  .ls-h3 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
    font-weight: 650;
    font-family: var(--ls-font-display);
    line-height: 1.25;
    color: var(--sl-color-white);
  }

  .ls-intro {
    max-width: 62ch;
    margin: 0;
  }
  .ls-note {
    max-width: 66ch;
    margin: 1.25rem 0 0;
    font-size: 0.9375rem;
    color: var(--sl-color-gray-3);
  }

  .ls-home :is(p, td, dd) code {
    font-family: var(--__sl-font-mono);
    font-size: 0.86em;
    padding: 0.1em 0.35em;
    border-radius: 0.3rem;
    background: var(--sl-color-bg-inline-code);
    color: var(--sl-color-white);
    overflow-wrap: anywhere;
  }

  .ls-home a {
    color: var(--sl-color-text-accent);
    text-underline-offset: 0.2em;
  }
  .ls-home a:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 3px;
    border-radius: 0.2rem;
  }

  /* Runs on / Ships: the quick answer to "does it fit my repo?", right under the hero. */

  .ls-strip {
    display: grid;
    gap: 1.5rem 3rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--sl-color-hairline-light);
  }
  @media (min-width: 60rem) {
    .ls-strip {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: start;
    }
  }
  .ls-strip__group {
    display: grid;
    gap: 0.75rem;
  }
  .ls-strip__label {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 650;
    font-family: var(--ls-font-display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  .ls-hosts,
  .ls-ships {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ls-hosts {
    gap: 1rem 2rem;
  }
  .ls-host {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--sl-color-white) !important;
    text-decoration: none;
    line-height: 1.3;
  }
  .ls-host strong {
    display: block;
    font-weight: 650;
    font-family: var(--ls-font-display);
  }
  .ls-host__detail {
    font-size: 0.875rem;
    color: var(--sl-color-gray-3);
  }
  .ls-host:hover strong {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .ls-ships {
    gap: 0.5rem;
  }
  .ls-ships .ls-target {
    padding: 0.4rem 0.8rem 0.4rem 0.7rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 999px;
    font-size: 0.9375rem;
  }
  .ls-ships .ls-target::before {
    width: 0.9rem;
  }
  .ls-ships .ls-target:hover {
    text-decoration: none;
    border-color: var(--trail, var(--sl-color-gray-4));
  }

  /* Steps: one triple trail runs down the numbers, like the logo's exhaust. */

  .ls-steps {
    position: relative;
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    gap: clamp(2.5rem, 5vw, 3.5rem);
  }
  .ls-steps::before {
    content: "";
    position: absolute;
    inset-block: 1.25rem 1.25rem;
    inset-inline-start: calc(1.25rem - 6px);
    width: 12px;
    background: linear-gradient(
      90deg,
      var(--ls-trail-sky) 0 2px,
      transparent 2px 5px,
      var(--ls-trail-flame) 5px 7px,
      transparent 7px 10px,
      var(--ls-trail-violet) 10px 12px
    );
    opacity: 0.55;
  }
  .ls-step {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    column-gap: 1.25rem;
    row-gap: 1rem;
  }
  .ls-step__number {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--sl-color-black);
